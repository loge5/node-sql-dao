{
  "name": "sql-dao",
  "version": "1.4.2",
  "description": "database access objects for sql databases",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "cover": "jest --coverage",
    "format": "node node_modules/standard/bin/cmd.js --fix",
    "prerelease": "npm test",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loge5/node-sql-dao.git"
  },
  "keywords": [
    "dao",
    "doa",
    "sql",
    "database",
    "access",
    "objects",
    "mysql"
  ],
  "author": "Rolf Loges",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "mysql": "^2.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "standard": "^17.1.2",
    "standard-version": "^9.5.0"
  },
  "standard": {
    "ignore": [
      "config"
    ],
    "env": [
      "jest"
    ]
  }
}
